{
  "schemaVersion": 1,
  "taskOwnedPathPatterns": ["frontend/**", "backend/**", "AI/**", "docs/**", "scripts/**", "contracts/**", "mocks/**", "*.json", "*.md"],
  "allowedSharedDependencyPaths": ["node_modules/**", ".next/**", "backend/dist/**", "backend/node_modules/**", "frontend/node_modules/**"],
  "forbiddenPathPatterns": [".git/**", ".gitignore", "node_modules/**", ".next/**", "backend/dist/**"],
  "generatedOutputPaths": ["frontend/.next/**", "backend/dist/**", "**/*.js.map"],
  "runtimeStatePaths": [".git/**", "logs/**", "*.tmp", "temp/**"],
  "frameworkBuildOutputPaths": ["frontend/.next/**", "backend/dist/**"],
  "exactStagingRules": {
    "required": true,
    "forbiddenPatterns": [".", "-A", "--all"],
    "receiptRequired": true,
    "receiptProducer": "scripts/task-governor.mjs stage"
  },
  "baselineDirtyStateCapture": true,
  "taskWorktreeCleanliness": "required before finalization",
  "detachedWorktreeRequirements": {
    "productionBuilds": true,
    "runtimeAcceptance": true,
    "screenshotCapture": true,
    "deploymentPreview": true,
    "highRiskPostCommit": true,
    "exactCommitRequired": true,
    "uniquePathRequired": true,
    "headRecordingRequired": true,
    "removalByExactPath": true
  }
}
