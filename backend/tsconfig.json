{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../AI/*"]
    },
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "rootDir": ".."
  },
  "files": ["src/index.ts"],
  "exclude": ["node_modules", "dist"]
}
