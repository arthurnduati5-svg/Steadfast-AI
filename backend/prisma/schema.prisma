  metadata              Json?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  LatencyThresholdAlert LatencyThresholdAlert[]
  StudentProfile        StudentProfile          @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@unique([studentId, turnId])
  @@index([responseMode, createdAt])
  @@index([route, createdAt])
  @@index([sessionId, createdAt])
  @@index([studentId, createdAt])
  @@index([thresholdBreached, createdAt])
}

