  cancelledAt            DateTime?
  blockedAt              DateTime?
  durationSecondsAllowed Int       @default(0)
  durationSecondsUsed    Int       @default(0)
  safeAttemptSummary     String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime

  @@index([deliverySessionId])
  @@index([paperVersionId])
  @@index([schoolId])
  @@index([startedAt])
  @@index([status])
  @@index([studentRef])
  @@index([submittedAt])
  @@index([variantAssignmentId])
  @@index([variantId])
}

model ExamAttemptSubmissionSnapshotRecord {
  submissionSnapshotId  String    @id
  schoolId              String
  attemptId             String
  deliverySessionId     String
  paperId               String
  paperVersionId        String
  variantId             String
  studentRef            String
  snapshotStatus        String    @default("draft")
  submittedAnswerCount  Int       @default(0)
  questionSnapshotCount Int       @default(0)
  totalMarksAvailable   Int       @default(0)
  submissionPayloadJson Json?
  safeSnapshotSummary   String
  createdAt             DateTime  @default(now())
  sealedAt              DateTime?

  @@index([attemptId])
  @@index([createdAt])
  @@index([deliverySessionId])
  @@index([schoolId])
  @@index([sealedAt])
  @@index([snapshotStatus])
  @@index([studentRef])
}

model ExamAttemptTimingEventRecord {
  timingEventId            String   @id
  schoolId                 String
  attemptId                String
  deliverySessionId        String
  eventType                String
  eventAt                  DateTime @default(now())
  durationSecondsUsed      Int      @default(0)
  durationSecondsRemaining Int      @default(0)
  safeTimingSummary        String
  metadataJson             Json?
  createdAt                DateTime @default(now())

  @@index([attemptId])
  @@index([createdAt])
  @@index([deliverySessionId])
  @@index([eventAt])
  @@index([eventType])
  @@index([schoolId])
}

model ExamBlueprintRecord {
  blueprintId         String    @id
  schoolId            String
  status              String    @default("draft")
  title               String
  subjectId           String
  curriculumVersionId String
  gradeBand           String
  examType            String
  createdByActorId    String
  createdByRole       String
  currentVersionId    String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime
  archivedAt          DateTime?

  @@index([currentVersionId])
  @@index([curriculumVersionId])
  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, subjectId])
}

model ExamBlueprintRequirementRecord {
  requirementId         String   @id
  blueprintVersionId    String
  schoolId              String
  requirementType       String
  subjectId             String
  topicId               String
  skillId               String
  objectiveId           String
  requiredQuestionCount Int      @default(0)
  requiredMarks         Int      @default(0)
  minimumDifficulty     String   @default("recall")
  maximumDifficulty     String   @default("creation")
  questionType          String   @default("multiple_choice")
  weight                Int      @default(1)
  isMandatory           Boolean  @default(true)
  createdAt             DateTime @default(now())

  @@index([blueprintVersionId])
  @@index([objectiveId])
  @@index([questionType])
  @@index([schoolId])
  @@index([skillId])
  @@index([topicId])
}

model ExamBlueprintVersionRecord {
  blueprintVersionId       String    @id
  blueprintId              String
