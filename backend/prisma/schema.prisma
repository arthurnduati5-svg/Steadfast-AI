  @@index([accessPolicyId])
  @@index([closedAt])
  @@index([createdAt])
  @@index([deliveryBridgeId])
  @@index([openedAt])
  @@index([paperId])
  @@index([paperVersionId])
  @@index([schoolId])
  @@index([schoolId, status])
}

model ExamDeliverySessionStateRecord {
  sessionStateId        String   @id
  schoolId              String
  deliverySessionId     String
  status                String   @default("draft")
  activeAttemptCount    Int      @default(0)
  submittedAttemptCount Int      @default(0)
  pausedAttemptCount    Int      @default(0)
  blockedAttemptCount   Int      @default(0)
  lastStateChangeReason String?
  safeStateSummary      String
