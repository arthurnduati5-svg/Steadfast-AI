  @@index([schoolId])
  @@index([status])
  @@index([updatedAt])
}

model ExamDraftQuestionRecord {
  draftQuestionId   String   @id
  draftId           String
  schoolId          String
  questionId        String
  questionVersionId String
  position          Int      @default(0)
  sectionKey        String   @default("default")
  marksAllocated    Int      @default(0)
  selectionReason   String
  requirementId     String
