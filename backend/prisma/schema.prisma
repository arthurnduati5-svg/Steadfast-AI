  warningCodesJson  Json?
  createdAt         DateTime @default(now())

  @@index([draftId])
  @@index([position])
  @@index([questionId])
  @@index([questionVersionId])
  @@index([requirementId])
  @@index([schoolId])
}

model ExamDraftRecord {
  draftId                     String   @id
  draftSetId                  String
  schoolId                    String
  blueprintId                 String
  blueprintVersionId          String
  rank                        Int      @default(0)
  status                      String   @default("candidate")
  draftTitle                  String
  totalMarks                  Int      @default(0)
