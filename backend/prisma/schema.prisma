generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdaptiveChallengeRecord {
  id                      String   @id
  schoolId                String
  tutorLearnerId          String
  studentId               String?
  sessionId               String?
  subject                 String
  topic                   String?
  skillTag                String?
  challengeType           String
  difficultyLevel         String
  status                  String   @default("active")
  learnerPrompt           String
  socraticOpeningQuestion String?
  allowedHints            Json     @default("[]")
  safeEvidenceRefs        Json     @default("[]")
  reasonCodes             Json     @default("[]")
  privacyMetadata         Json     @default("{}")
  attemptSubmitted        Boolean  @default(false)
  attemptOutcome          String?
  hintLevelUsed           Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime

  @@index([schoolId, tutorLearnerId])
  @@index([schoolId, tutorLearnerId, status])
  @@index([tutorLearnerId])
}

model AdaptiveRecommendationProfileRecord {
  id                            String   @id
  schoolId                      String
  tutorLearnerId                String   @unique
  preferredSupportLevel         String   @default("guided_support")
  preferredStepSize             String   @default("standard")
  practiceModePreference        String   @default("balanced")
  challengeReadinessSignal      String   @default("medium")
  foundationReviewPreference    String   @default("medium")
  hintFrequencySignal           String   @default("medium")
  difficultyCalibration         Float    @default(0.5)
  recentTooHardCount            Int      @default(0)
  recentTooEasyCount            Int      @default(0)
  recentConfusionCount          Int      @default(0)
  recentChallengeRequestCount   Int      @default(0)
  recentTeacherHelpRequestCount Int      @default(0)
  profileSnapshot               Json?
  privacyMetadata               Json?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime

  @@index([schoolId])
  @@index([schoolId, tutorLearnerId])
}

model AnswerKeyVersionRecord {
  answerKeyVersionId      String    @id
  questionVersionId       String
  status                  String    @default("draft")
  answerKeySafeRef        String
  correctAnswerSummary    String
  markingNotesTeacherOnly String
  createdByActorId        String
  createdAt               DateTime  @default(now())
  approvedAt              DateTime?

  @@index([questionVersionId])
}

model ApprovedSourceRecord {
  id                String    @id
  schoolId          String?
  sourceKey         String
  title             String
  sourceType        String
  curriculumFamily  String
  subject           String?
  stage             String?
  topic             String?
  deenCategory      String?
  trustLevel        String
  approvalStatus    String    @default("pending_review")
  approvedByActorId String?
  approvedByRole    String?
  approvedAt        DateTime?
  reviewRequired    Boolean   @default(true)
  restrictedUse     Boolean   @default(false)
  citationMetadata  Json?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime

  @@index([approvalStatus])
  @@index([curriculumFamily])
  @@index([schoolId])
  @@index([trustLevel])
}

model ChatMessage {
  id            String         @id
  sessionId     String
  role          String
  content       String
  timestamp     DateTime       @default(now())
  messageNumber Int
  metadata      Json?
  ChatSession   ChatSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  RevisionItem  RevisionItem[]

  @@index([sessionId])
  @@index([timestamp])
}

model ChatSession {
  id                String              @id
  studentId         String
  startTime         DateTime            @default(now())
  endTime           DateTime?
  topic             String?
  isActive          Boolean             @default(true)
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  summarization     String?
  ChatMessage       ChatMessage[]
  StudentProfile    StudentProfile      @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  RevisionItem      RevisionItem[]
  VoiceSessionUsage VoiceSessionUsage[]

  @@index([studentId, updatedAt])
}

model CommittedLearningEvidenceProjection {
  committedEvidenceId      String    @id
  evidenceCandidateId      String    @unique
  schoolId                 String
  learnerId                String
  objectiveId              String?
  skillId                  String?
  topicId                  String?
  conceptId                String?
  outcome                  String
  evidenceMode             String
  independence             String
  confidenceState          String
  integrityState           String
  finalizationState        String
  evidenceWeightSuggestion Float?
  active                   Boolean   @default(true)
  supersededByEvidenceId   String?
  committedAt              DateTime?
  retainedAt               DateTime?
  latestSequence           Int       @default(0)
  version                  Int       @default(1)

  @@unique([schoolId, committedEvidenceId])
  @@index([schoolId, learnerId, active])
  @@index([schoolId, learnerId])
}

model ContentGapRecord {
  id               String   @id
  schoolId         String?
  curriculumFamily String
  subject          String?
  topic            String?
  skill            String?
  gapType          String
  status           String   @default("open")
  safeSummary      String
  reasonCodes      Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime

  @@index([curriculumFamily])
  @@index([gapType])
  @@index([schoolId])
  @@index([status])
}

model ContentGovernanceAuditRecord {
  id                  String   @id
  schoolId            String?
  actorId             String?
  actorRole           String
  eventType           String
  curriculumFamily    String?
  curriculumVersionId String?
  sourceId            String?
  contentItemId       String?
  decision            String
  reasonCodes         Json     @default("[]")
  privacyMetadata     Json?
  requestId           String?
  correlationId       String?
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([curriculumFamily])
  @@index([eventType])
  @@index([schoolId])
}

model ContentItemRecord {
  id                  String   @id
  schoolId            String?
  curriculumVersionId String?
  topicId             String?
  skillId             String?
  learningObjectiveId String?
  sourceId            String?
  contentType         String
  status              String   @default("draft")
  sensitivity         String   @default("basic")
  studentSafeContent  String?
  teacherSafeContent  String?
  answerKeyProtected  Boolean  @default(false)
  teacherOnly         Boolean  @default(false)
  reviewState         String   @default("not_reviewed")
  reasonCodes         Json?
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime

  @@index([curriculumVersionId])
  @@index([learningObjectiveId])
  @@index([reviewState])
  @@index([schoolId])
  @@index([skillId])
  @@index([status])
  @@index([topicId])
}

model ContentReviewRecord {
  id                String    @id
  schoolId          String?
  targetType        String
  targetId          String
  reviewState       String    @default("not_reviewed")
  reviewedByActorId String?
  reviewedByRole    String?
  reviewedAt        DateTime?
  decision          String
  reasonCodes       Json?
  safeNotes         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime

  @@index([reviewState])
  @@index([schoolId])
  @@index([targetType, targetId])
}

model ConversationArchiveRecord {
  id                String   @id
  schoolId          String
  tutorLearnerId    String
  externalStudentId String?
  sessionId         String?
  archiveDate       DateTime @default(now())
  retentionUntil    DateTime
  visibilityTier    String   @default("system_only")
  redactionStatus   String   @default("not_redacted")
  summary           String?
  messageCount      Int      @default(0)
  subjectTags       String[] @default([])
  firstMessageAt    DateTime
  lastMessageAt     DateTime
  tokenCount        Int?
  metadata          Json?
  rawContent        String?
  redactedContent   String?
  redactionApplied  Boolean  @default(false)
  storagePolicy     String   @default("retained_raw")
  sender            String   @default("learner")
  sourceSurface     String   @default("unknown")
  safetyTags        String[] @default([])
  topicId           String?
  subjectId         String?
  curriculumTrack   String   @default("unknown")
  createdAt         DateTime @default(now())
  updatedAt         DateTime

  @@index([retentionUntil])
  @@index([schoolId, archiveDate])
  @@index([schoolId, tutorLearnerId])
  @@index([sender])
  @@index([storagePolicy])
  @@index([tutorLearnerId, archiveDate])
  @@index([visibilityTier])
}

model CopilotPreferences {
  id                String         @id
  userId            String         @unique
  preferredLanguage String
  interests         Json
  lastUpdatedAt     DateTime
  createdAt         DateTime       @default(now())
  StudentProfile    StudentProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model CurriculumSkillRecord {
  id                                                                               String                    @id
  curriculumTopicId                                                                String
  skillCode                                                                        String?
  title                                                                            String
  studentSafeDescription                                                           String?
  teacherSafeDescription                                                           String?
  difficultyBand                                                                   String?
  status                                                                           String                    @default("active")
  metadata                                                                         Json?
  createdAt                                                                        DateTime                  @default(now())
  updatedAt                                                                        DateTime
  CurriculumTopicRecord                                                            CurriculumTopicRecord     @relation(fields: [curriculumTopicId], references: [id], onDelete: Cascade)
  LearningObjectiveRecord                                                          LearningObjectiveRecord[]
  PrerequisiteLinkRecord_PrerequisiteLinkRecord_fromSkillIdToCurriculumSkillRecord PrerequisiteLinkRecord[]  @relation("PrerequisiteLinkRecord_fromSkillIdToCurriculumSkillRecord")
  PrerequisiteLinkRecord_PrerequisiteLinkRecord_toSkillIdToCurriculumSkillRecord   PrerequisiteLinkRecord[]  @relation("PrerequisiteLinkRecord_toSkillIdToCurriculumSkillRecord")

  @@index([curriculumTopicId])
  @@index([status])
}

model CurriculumTopicRecord {
  id                      String                  @id
  curriculumVersionId     String
  subject                 String
  stage                   String?
  topicCode               String?
  title                   String
  descriptionSafe         String?
  status                  String                  @default("active")
  metadata                Json?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime
  CurriculumSkillRecord   CurriculumSkillRecord[]
  CurriculumVersionRecord CurriculumVersionRecord @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)

  @@index([curriculumVersionId])
  @@index([status])
  @@index([subject])
}

model CurriculumVersionRecord {
  id                    String                  @id
  schoolId              String?
  curriculumFamily      String
  versionCode           String
  title                 String
  status                String                  @default("draft")
  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  metadata              Json?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  CurriculumTopicRecord CurriculumTopicRecord[]

  @@unique([schoolId, curriculumFamily, versionCode])
  @@index([curriculumFamily])
  @@index([schoolId])
  @@index([status])
}

model DailyObjectiveCheckSessionRecord {
  checkSessionId          String    @id
  schoolId                String
  studentId               String
  classId                 String?
  subjectId               String?
  topicId                 String?
  skillId                 String?
  objectiveId             String
  dailySeedId             String?
  blueprintId             String?
  sourceTruthStatus       String
  status                  String
  requiredSteps           Json      @default("[]")
  completedSteps          Json      @default("[]")
  confidenceBefore        String?
  confidenceAfter         String?
  safeSignalBuckets       Json      @default("[]")
  safeEvidenceRefs        Json      @default("[]")
  modeDestinationsUsed    Json      @default("[]")
  attemptCount            Int       @default(0)
  hintUsageBucket         String?
  explanationQualityBucket String?
  recallQualityBucket     String?
  teachBackQualityBucket  String?
  transferCheckBucket     String?
  delayedRecallBucket     String?
  antiCheatSignalLabels   Json      @default("[]")
  learnerSafeReason       String?
  teacherSafeReason       String?
  evidenceId              String?
  masteryResult           Json?
  weakSignalRef           String?
  version                 Int       @default(1)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime
  completedAt             DateTime?

  @@index([schoolId, studentId])
  @@index([schoolId])
  @@index([objectiveId])
  @@index([status])
}

model DailyObjectiveCheckAttemptRecord {
  attemptId                String   @id
  checkSessionId           String
  schoolId                 String
  studentId                String
  objectiveId              String
  attemptType              String
  signalBucket             String
  hintUsageBucket          String?
  explanationQualityBucket String?
  recallQualityBucket      String?
  teachBackQualityBucket   String?
  transferCheckBucket      String?
  delayedRecallBucket      String?
  antiCheatLabels          Json     @default("[]")
  timeSpentSeconds         Int?
  safeEvidenceRef          String?
  createdAt                DateTime @default(now())

  @@index([checkSessionId])
  @@index([schoolId, studentId])
}

model DailyObjectiveCheckConfidenceRecord {
  checkpointId   String   @id
  checkSessionId String
  schoolId       String
  studentId      String
  objectiveId    String
  checkpointType String
  confidenceLevel String
  recordedAt     DateTime @default(now())

  @@unique([checkSessionId, checkpointType])
  @@index([checkSessionId])
  @@index([schoolId, studentId])
}

model DailyObjectiveCheckCompletionIdempotencyRecord {
  idempotencyKey    String   @id
  checkSessionId    String   @unique
  schoolId          String
  studentId         String
  evidenceId        String?
  masteryApplied    Boolean  @default(false)
  weakSignalCreated Boolean  @default(false)
  completionStatus  String?
  result            Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime

  @@index([schoolId, studentId])
}

model DifficultyCalibrationRecord {
  id                     String   @id
  schoolId               String
  tutorLearnerId         String
  subject                String
  topic                  String?
  skillTag               String?
  currentDifficultyLevel String   @default("standard")
  supportLevel           String   @default("moderate")
  calibrationSignals     Json     @default("[]")
  recentSuccessCount     Int      @default(0)
  recentStruggleCount    Int      @default(0)
  recentHintDependency   Int      @default(0)
  recentTooHardCount     Int      @default(0)
  recentTooEasyCount     Int      @default(0)
  lastCalibratedAt       DateTime @default(now())
  privacyMetadata        Json     @default("{}")
  createdAt              DateTime @default(now())
  updatedAt              DateTime

  @@unique([schoolId, tutorLearnerId, subject, skillTag])
  @@index([schoolId, tutorLearnerId])
  @@index([tutorLearnerId])
}

model DurableAuditEvent {
  id               String   @id
  category         String
  eventType        String
  severity         String
  visibility       String
  actorType        String
  actorIdHash      String?
  studentIdHash    String?
  schoolIdHash     String?
  classIdHash      String?
  requestId        String?
  traceId          String?
  route            String?
  method           String?
  serviceName      String?
  operation        String?
  safeSummary      String
  safeMetadataJson Json?
  redactionJson    Json
  occurredAt       DateTime
  persistedAt      DateTime @default(now())

  @@index([category, occurredAt])
  @@index([requestId])
  @@index([schoolIdHash, occurredAt])
  @@index([studentIdHash, occurredAt])
  @@index([traceId])
  @@index([visibility, occurredAt])
}

model ExamAccessPolicyRecord {
  accessPolicyId            String   @id
  schoolId                  String
  paperId                   String
  paperVersionId            String
  status                    String   @default("draft")
  intendedAudienceType      String   @default("class")
  classScopeRefsJson        Json?
  roleScopeRefsJson         Json?
  availabilityMode          String   @default("manual_teacher_activation")
  requiresTeacherActivation Boolean  @default(true)
  allowStudentSelfStart     Boolean  @default(false)
  allowRetake               Boolean  @default(false)
  maxAttempts               Int      @default(1)
  safePolicySummary         String
  createdByActorId          String
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime

  @@index([createdAt])
  @@index([intendedAudienceType])
  @@index([paperId])
  @@index([paperVersionId])
  @@index([schoolId])
  @@index([status])
}

model ExamAnswerSubmissionRecord {
  answerSubmissionId        String    @id
  schoolId                  String
  attemptId                 String
  attemptQuestionSnapshotId String
  deliverySessionId         String
  studentRef                String
  answerStatus              String    @default("draft_saved")
  answerTextSafe            String?
  answerPayloadJson         Json?
  attachmentRefsJson        Json?
  clientSavedAt             DateTime?
  serverReceivedAt          DateTime  @default(now())
  revisionNumber            Int       @default(1)
  isFinal                   Boolean   @default(false)
  safeSubmissionSummary     String
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime

  @@index([answerStatus])
  @@index([attemptId])
  @@index([attemptQuestionSnapshotId])
  @@index([isFinal])
  @@index([schoolId])
  @@index([serverReceivedAt])
  @@index([studentRef])
}

model ExamAttemptQuestionSnapshotRecord {
  attemptQuestionSnapshotId String   @id
  schoolId                  String
  attemptId                 String
  deliverySessionId         String
  paperQuestionId           String
  variantQuestionId         String
  questionId                String
  questionVersionId         String
  sectionKey                String
  displayOrder              Int      @default(0)
  marksAvailable            Int      @default(0)
  studentVisiblePromptSafe  String
  answerInputType           String   @default("text")
  snapshotStatus            String   @default("active")
  createdAt                 DateTime @default(now())

  @@index([attemptId])
  @@index([deliverySessionId])
  @@index([displayOrder])
  @@index([paperQuestionId])
  @@index([questionId])
  @@index([questionVersionId])
  @@index([schoolId])
  @@index([variantQuestionId])
}

model ExamAttemptRecord {
  attemptId              String    @id
  schoolId               String
  deliverySessionId      String
