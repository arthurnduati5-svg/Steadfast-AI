  correlationId     String?
  createdAt         DateTime @default(now())

  @@index([actorId])
  @@index([attemptId])
  @@index([correlationId])
  @@index([createdAt])
  @@index([deliverySessionId])
  @@index([eventType])
  @@index([requestId])
