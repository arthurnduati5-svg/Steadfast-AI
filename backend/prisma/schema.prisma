  coveragePolicy           String    @default("balanced_weighted")
  selectionStrategy        String    @default("balanced")
  createdByActorId         String
  createdAt                DateTime  @default(now())
  approvedAt               DateTime?
  supersededAt             DateTime?

  @@index([blueprintId])
  @@index([blueprintId, versionNumber])
  @@index([securityClassRequirement])
  @@index([status])
}

model ExamDeliveryAuditRecord {
  deliveryAuditId   String   @id
  schoolId          String
  deliverySessionId String?
  attemptId         String?
  actorId           String
  actorRole         String
  eventType         String
  decision          String
  safeSummary       String
  reasonCodesJson   Json?
